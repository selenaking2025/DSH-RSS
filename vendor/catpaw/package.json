{
  "name": "catpaw",
  "productName": "Catpaw",
  "description": "A local-first RSS reader.",
  "version": "0.1.5",
  "private": true,
  "catpawRelease": {
    "downloadUrl": "https://atlasnote.ai/zh-CN/products"
  },
  "main": "dist/main/main.js",
  "build": {
    "appId": "ai.catpaw.reader",
    "productName": "Catpaw",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "npmRebuild": false,
    "publish": {
      "provider": "generic",
      "url": "https://dl.atlasnote.ai/updates/stable/",
      "channel": "catpaw",
      "useMultipleRangeRequest": false
    },
    "afterPack": "./scripts/write-update-config.cjs",
    "electronUpdaterCompatibility": ">=6.8.9",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/main/**/*",
      "!dist/main/tests/**/*",
      "dist/renderer/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.txt"
    ],
    "mac": {
      "category": "public.app-category.news",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "signIgnore": [
        "\\.pak$",
        "/Versions/Current/"
      ]
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "dmg": {
      "sign": true,
      "writeUpdateInfo": false,
      "filesystem": "HFS+"
    }
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:main\"",
    "desktop:dev": "npm run dev",
    "dev:renderer": "vite",
    "dev:main": "electron electron/dev-main.cjs",
    "dev:cli": "electron electron/dev-cli.cjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.main.json && cp electron/preload.js dist/main/preload.js && vite build",
    "package:mac": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false ELECTRON_BUILDER_CACHE=\"$PWD/.tmp/electron-builder\" electron-builder --mac --arm64 --dir --config.electronDist=node_modules/electron/dist",
    "migrate:rss": "ELECTRON_RUN_AS_NODE=1 electron scripts/migrate-snowpaw-rss.mjs",
    "rebuild": "NODE_USE_ENV_PROXY=1 node scripts/rebuild-native.mjs",
    "postinstall": "NODE_USE_ENV_PROXY=1 node scripts/rebuild-native.mjs",
    "preview": "vite preview",
    "lint": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "npm run test:standalone-reader-boundary && npm run test:youtube-embed-session && npm run test:rss-reader-video-embed && npm run test:rss-migration && npm run test:runtime && npm run test:child-worker-manager && npm run test:entry-repo && npm run test:feed-fetch-meta && npm run test:feed-management && npm run test:opml && npm run test:source-endpoint-policy && npm run test:source-endpoint-health && npm run test:feed-discovery && npm run test:refresh-settings && npm run test:scheduled-refresh && npm run test:socks-lifecycle && npm run test:rss-proxy && npm run test:rss-refresh-retry && npm run test:rss-backfill && npm run test:rss-job-cancel && npm run test:rss-backfill-routing && npm run test:web-cli-twitter && npm run test:x-api-twitter && npm run test:html-article-listing && npm run test:stabilization && npm run test:database-backup && npm run test:architecture && npm run test:run-command && npm run test:model-providers && npm run test:article-translation && npm run test:feed-sync-lifecycle && npm run test:feed-batch && npm run test:reader-job-contract && npm run test:rss-worker-lifecycle && npm run test:rss-request-ownership && npm run test:ipc-registration && npm run test:rss-backfill-failures && npm run test:source-initialization && npm run test:rss-run-contract && npm run test:twitter-model && npm run test:article-summary && npm run test:source-policy && npm run test:rss-job-scheduling && npm run test:maintenance && npm run test:subscriptions && npm run test:rss-job-contract && npm run test:request-scheduling && npm run test:app-updates && npm run test:smart-reading",
    "test:ui": "node scripts/reader-ui-smoke.mjs",
    "test:reader-improvements-ui": "node scripts/reader-improvements-ui-smoke.mjs",
    "test:model-providers": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/model-providers.ts",
    "test:model-providers-ui": "node scripts/model-providers-ui-smoke.mjs",
    "test:cancel-history-ui": "node scripts/cancel-and-history-smoke.mjs",
    "test:package": "node scripts/packaged-ui-smoke.mjs",
    "verify:youtube-packaged": "node scripts/youtube-playback-smoke.mjs",
    "check": "npm run lint && npm run test:desktop-release && npm test",
    "test:desktop-release": "node --test scripts/desktop-release.test.mjs scripts/update-release.test.mjs",
    "cli": "electron dist/main/cli-desktop.js",
    "test:standalone-reader-boundary": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/standalone-reader-boundary.ts",
    "test:youtube-embed-session": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/youtube-embed-session.ts",
    "test:rss-reader-video-embed": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs renderer/tests/rss-reader-video-embed.ts",
    "test:rss-migration": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs scripts/migrate-snowpaw-rss.test.mjs",
    "test:runtime": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/runtime-user-data-dir.ts",
    "test:runtime:built": "ELECTRON_RUN_AS_NODE=1 electron dist/main/tests/runtime-user-data-dir.js",
    "test:child-worker-manager": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/child-worker-manager.ts",
    "test:child-worker-manager:built": "ELECTRON_RUN_AS_NODE=1 electron dist/main/tests/child-worker-manager.js",
    "test:rss-proxy": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/rss-proxy.ts",
    "test:rss-refresh-retry": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/rss-refresh-retry.ts",
    "test:rss-backfill": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/rss-backfill.ts",
    "test:rss-job-cancel": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/rss-job-cancel.ts",
    "test:rss-backfill-routing": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/rss-backfill-routing.ts",
    "test:web-cli-twitter": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/web-cli-twitter.ts",
    "test:html-article-listing": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/html-article-listing.ts",
    "test:entry-repo": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/entry-repo.ts",
    "test:feed-fetch-meta": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/feed-fetch-meta.ts",
    "test:feed-management": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/feed-management.ts",
    "test:opml": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/opml.ts",
    "test:source-endpoint-policy": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/source-endpoint-policy.ts",
    "test:source-endpoint-health": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/source-endpoint-health.ts",
    "test:feed-discovery": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/feed-discovery.ts",
    "test:refresh-settings": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/refresh-settings.ts",
    "test:scheduled-refresh": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/scheduled-refresh.ts",
    "test:x-api-twitter": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/x-api-twitter.ts",
    "verify:data-isolation:source": "npm run test:runtime && npm run test:child-worker-manager",
    "verify:data-isolation:built": "npm run build && npm run test:runtime:built && npm run test:child-worker-manager:built",
    "verify:data-isolation": "npm run verify:data-isolation:source && npm run verify:data-isolation:built",
    "test:stabilization": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/stabilization.ts",
    "test:database-backup": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/database-backup.ts",
    "test:stabilization-ui": "node scripts/stabilization-ui-smoke.mjs",
    "test:performance": "ELECTRON_RUN_AS_NODE=1 electron scripts/reader-performance.cjs",
    "package:candidate": "npm run build && node scripts/third-party-notices.mjs && node scripts/package-desktop.mjs",
    "package:dmg": "npm run package:candidate -- --dmg",
    "package:updates": "npm run package:candidate -- --updates --dmg",
    "package:ci": "npm run build && node scripts/third-party-notices.mjs && node scripts/package-desktop.mjs --ci",
    "release:verify": "node scripts/verify-release.mjs",
    "release:verify-updates": "node scripts/verify-update-artifacts.mjs",
    "test:architecture": "node scripts/architecture-rules.test.mjs && node scripts/verify-architecture.mjs",
    "release:notarize": "node scripts/notarize-candidate.mjs",
    "release:finalize": "node scripts/package-desktop.mjs --finalize",
    "test:run-command": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/run-command.ts",
    "test:article-translation": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/article-translation.ts && ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs renderer/tests/article-translation-document.ts && ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/article-translation-repo.ts",
    "test:article-translation-ui": "node scripts/article-translation-ui-smoke.mjs",
    "test:feed-sync-lifecycle": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/feed-sync-lifecycle.ts",
    "test:feed-batch": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/feed-batch.ts",
    "test:reader-job-contract": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/reader-job-contract.ts",
    "test:reader-races-ui": "node scripts/reader-races-ui-smoke.mjs",
    "test:background-updates-ui": "node scripts/background-updates-ui-smoke.mjs",
    "test:priority-refresh-ui": "node scripts/priority-refresh-ui-smoke.mjs",
    "test:rss-worker-lifecycle": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/rss-worker-lifecycle.ts",
    "test:rss-request-ownership": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/rss-request-ownership.ts",
    "test:ipc-registration": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/ipc-registration.ts",
    "test:rss-backfill-failures": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/rss-backfill-failures.ts",
    "test:source-initialization": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/source-initialization.ts",
    "test:rss-run-contract": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/rss-run-contract.ts && ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs renderer/tests/rss-run-contract.ts",
    "test:twitter-model": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/twitter-model.ts",
    "test:article-summary": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/article-summary.ts && ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/article-summary-repo.ts",
    "test:article-summary-ui": "node scripts/article-summary-ui-smoke.mjs",
    "test:source-policy": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/source-policy.ts",
    "test:rss-job-scheduling": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/rss-job-scheduling.ts",
    "test:maintenance": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/maintenance.ts",
    "test:maintenance-ui": "node scripts/maintenance-ui-smoke.mjs",
    "test:subscriptions": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/subscriptions.ts",
    "test:rss-job-contract": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/rss-job-contract.ts",
    "test:socks-lifecycle": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/socks-lifecycle.ts",
    "test:request-scheduling": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/request-scheduling.ts",
    "test:mixed-load-ui": "node scripts/mixed-load-ui-smoke.mjs",
    "test:browser-policy-ui": "node scripts/browser-policy-ui-smoke.mjs",
    "test:app-updates": "ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/app-updates.ts",
    "test:app-updates-ui": "node scripts/app-updates-ui-smoke.mjs",
    "test:smart-reading": "node --import tsx electron/tests/decision-provider.ts && node --import tsx electron/tests/smart-reading-domain.ts && ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/smart-reading-repo.ts && ELECTRON_RUN_AS_NODE=1 electron -r tsx/cjs electron/tests/reading-worker-priority.ts && node --import tsx scripts/jev-evaluation.test.ts",
    "test:smart-reading-ui": "node scripts/smart-reading-ui-smoke.mjs",
    "jev:evaluate": "node --import tsx scripts/evaluate-jev.ts",
    "jev:configure": "node --import tsx scripts/configure-jev.ts",
    "test:reading-performance": "ELECTRON_RUN_AS_NODE=1 electron scripts/reading-performance.cjs"
  },
  "dependencies": {
    "@chenglou/pretext": "0.0.9",
    "@mozilla/readability": "0.6.0",
    "@tanstack/react-virtual": "3.14.11",
    "better-sqlite3": "13.0.3",
    "dompurify": "3.4.15",
    "electron-updater": "6.8.9",
    "fast-xml-parser": "5.11.1",
    "http-proxy-agent": "7.0.2",
    "https-proxy-agent": "7.0.6",
    "jsdom": "^24.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/jsdom": "21.1.7",
    "@types/node": "24.13.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "^8.2.2",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "js-yaml": "4.3.2",
    "playwright": "1.63.0",
    "tsx": "4.23.13",
    "typescript": "^5.4.5",
    "vite": "8.2.2"
  },
  "engines": {
    "node": ">=24.9 <25"
  },
  "license": "UNLICENSED"
}
