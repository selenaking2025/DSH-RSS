{
  "name": "dsh-catpaw",
  "version": "0.1.0",
  "description": "Catpaw RSS reader and agent tools for DeepSeek Harness",
  "private": true,
  "type": "module",
  "main": "dist/host.js",
  "exports": {
    ".": "./dist/host.js",
    "./client": "./dist/client.js"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "PLAN.md",
    "VALIDATION.md",
    "vendor/catpaw/SOURCE.json",
    "vendor/catpaw/THIRD_PARTY_NOTICES.txt"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "sync:catpaw": "node scripts/sync-catpaw.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run build && npm run typecheck && npm test",
    "dev": "node scripts/dev.mjs",
    "pack:plugin": "npm run build && npm pack --pack-destination output"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "dependencies": {
    "@chenglou/pretext": "0.0.9",
    "@mozilla/readability": "0.6.0",
    "@tanstack/react-virtual": "3.14.11",
    "better-sqlite3": "13.0.3",
    "dompurify": "3.4.15",
    "electron": "44.2.0",
    "fast-xml-parser": "5.11.1",
    "http-proxy-agent": "7.0.2",
    "https-proxy-agent": "7.0.6",
    "jsdom": "24.1.3",
    "rss-parser": "3.13.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/better-sqlite3": "9.6.0",
    "@types/jsdom": "21.1.7",
    "@types/node": "24.13.0",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.0",
    "esbuild": "0.25.10",
    "pnpm": "11.7.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
